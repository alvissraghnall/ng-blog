FROM node:22-alpine

RUN corepack enable && corepack prepare pnpm@10.20.0 --activate

WORKDIR /usr/src/app

COPY package.json pnpm-lock.yaml* ./

RUN pnpm install \
  --allow-build=@apollo/protobufjs \
  --allow-build=@nestjs/core \
  --allow-build=@scarf/scarf \
  --allow-build=bcrypt \
  --allow-build=core-js \
  --allow-build=unrs-resolver

COPY . .
RUN pnpm run build

EXPOSE 3000
CMD ["pnpm", "start:prod"]
